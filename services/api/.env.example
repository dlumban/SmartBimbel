# Server
PORT=4000
NODE_ENV=development

# Database (see docker-compose.yml at repo root for local dev)
DATABASE_URL="postgresql://smartbimbel:smartbimbel@localhost:5433/smartbimbel_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Firebase Admin (see docs/infrastructure.md for manual setup steps)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payments - Midtrans (sandbox until production business verification completes)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Chat - Stream Chat
STREAM_API_KEY=
STREAM_API_SECRET=

# In-app video (Phase 2) - Daily.co; optional — Zoom/Meet paste links still work
DAILY_API_KEY=

# WhatsApp Business API (via BSP - see docs/infrastructure.md)
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_BASE_URL=

# Email fallback
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@smartbimbel.id
SENDGRID_API_KEY=

# File storage
STORAGE_PROVIDER=local
CLOUDINARY_URL=

# Error monitoring
SENTRY_DSN=

# Maps
GOOGLE_MAPS_API_KEY=

# Public origin of apps/web - used to build the admin-generated student
# access link (services/api/src/access-links).
WEB_APP_URL=http://localhost:3000

# E2E testing only (Task 8.1) - MUST stay unset in every real deployment.
# When set (and NODE_ENV != production), FirebaseAdminService accepts a
# special "E2E.<base64url-json>" token in place of a real Firebase ID
# token, letting Playwright authenticate against a live server process
# with no real Firebase project. See services/api/src/auth/firebase-admin.service.ts.
E2E_AUTH_BYPASS_SECRET=
