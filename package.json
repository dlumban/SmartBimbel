{
  "name": "smartbimbel",
  "private": true,
  "version": "0.1.0",
  "description": "SmartBimbel - private tutor marketplace monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run build --filter=@smartbimbel/shared --filter=@smartbimbel/design-tokens && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": ">=2.2.0",
      "lodash": ">=4.18.0",
      "postcss": ">=8.5.23"
    }
  }
}
